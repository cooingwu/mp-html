/**
 * 锚点组件样式
 */

/* 锚点基础样式：不设圆角/阴影/背景——预设 shape、image、icon 各自带样式；
   曾经的 border-radius:50% + box-shadow 会让所有预设锚点背后出现一圈
   圆形半透明阴影（阴影跟随容器圆角，方形 shape 也呈圆形光晕）。
   默认红点的圆角与阴影由 .anchor-default 自带 */
.anchor-point {
  position: absolute;
  transform: translate(-50%, -50%);
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-sizing: border-box;
}

.anchor-point:active {
  transform: translate(-50%, -50%) scale(0.95);
}

/* 脉冲动画 - 应用在内部元素上，与管理端一致 */
.anchor-image.pulse,
.anchor-shape.pulse,
.anchor-icon.pulse,
.anchor-default.pulse {
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(0.85);
  }
}

/* 图片类型 */
.anchor-point.image {
  background: transparent;
}

.anchor-image {
  width: 100%;
  height: 100%;
}

/* 图形内容（圆角由内层的 .shape-circle/.shape-square/.shape-rounded 提供） */
.anchor-shape {
  width: 100%;
  height: 100%;
  box-sizing: border-box;
}

.anchor-shape.label-inside {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  /* 估算尺寸与实际渲染有偏差时，超出部分裁切在 shape 内 */
  overflow: hidden;
}

.shape-circle {
  border-radius: 50%;
}

.shape-square {
  border-radius: 2px;
}

.shape-rounded {
  border-radius: 8px;
}

/* 图标类型 */
.anchor-icon {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-svg {
  width: 100%;
  height: 100%;
}

/* 默认样式 */
.anchor-default {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
}

.anchor-order {
  color: #ffffff;
  font-size: 16px;
  font-weight: bold;
}

/* 说明文本 - 使用 px 单位，与管理端一致 */
.anchor-label {
  position: absolute;
  white-space: nowrap;
  font-size: 16px;
  color: #ffffff;
  background: rgba(142, 142, 142, 0.8);
  padding: 2px 8px;
  border-radius: 10px;
  max-width: 100px;
  overflow: hidden;
  text-overflow: ellipsis;
  pointer-events: none;
  box-shadow: 0 1px 4px rgba(142, 142, 142, 0.2);
  box-shadow: 0 1px 4px rgba(142, 142, 142, 0.2);
}

.label-right {
  left: calc(100% + 4px);
  left: calc(100% + 4px);
  top: 50%;
  transform: translateY(-50%);
}

.label-left {
  right: calc(100% + 4px);
  right: calc(100% + 4px);
  top: 50%;
  transform: translateY(-50%);
}

.label-top {
  bottom: calc(100% + 4px);
  bottom: calc(100% + 4px);
  left: 50%;
  transform: translateX(-50%);
}

.label-bottom {
  top: calc(100% + 4px);
  top: calc(100% + 4px);
  left: 50%;
  transform: translateX(-50%);
}

/* 隐藏位置 */
.label-hidden {
  display: none;
}

/* PC 端适配 */
@media (min-width: 768px) {
  .anchor-label {
    max-width: 150px;
  }
}
