<!--
  锚点组件模板
  用于在图片上显示单个可点击的锚点
-->
<view
  id="anchor-point"
  class="anchor-point {{styleType}}"
  style="left: {{anchor.position.x}}%; top: {{anchor.position.y}}%; width: {{size}}px; height: {{size}}px;"
  catch:tap="onTap"
  catch:touchstart="onTap"
  bind:touchmove="cancelTap"
>
  <image
    wx:if="{{styleType === 'image'}}"
    class="anchor-image {{animation ? 'pulse' : ''}}"
    src="{{styleImage}}"
    mode="aspectFit"
  />

  <view
    wx:elif="{{styleType === 'shape'}}"
    class="anchor-shape {{shapeClass}} {{animation ? 'pulse' : ''}}"
    style="{{shapeStyle}}"
  ></view>

  <view
    wx:elif="{{styleType === 'icon'}}"
    class="anchor-icon {{animation ? 'pulse' : ''}}"
  >
    <image
      class="icon-svg"
      src="{{iconSvg}}"
      mode="aspectFit"
    />
  </view>

  <view
    wx:else
    class="anchor-default {{animation ? 'pulse' : ''}}"
    style="background-color: {{anchor.style.color || '#ff4d4f'}};"
  >
    <text class="anchor-order" style="font-size: {{16 / (containerScaleFactor || 1)}}px;">{{anchor.order || ''}}</text>
  </view>

  <!-- 说明文本 -->
  <view
    wx:if="{{anchor.label && anchor.label.text}}"
    class="anchor-label label-{{labelPosition}}"
    style="font-size: {{16 / (containerScaleFactor || 1)}}px; padding: {{2 / (containerScaleFactor || 1)}}px {{8 / (containerScaleFactor || 1)}}px; border-radius: {{10 / (containerScaleFactor || 1)}}px; max-width: {{100 / (containerScaleFactor || 1)}}px;"
  >
    {{anchor.label.text}}
  </view>
</view>
