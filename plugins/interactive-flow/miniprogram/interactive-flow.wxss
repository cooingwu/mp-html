/**
 * 互动流程组件样式
 * 全部颜色走 CSS 变量（--if-*），未配置主题时使用内置深色金默认值，
 * 书籍级主题（publications.interactiveTheme）由组件根节点 style 注入覆盖
 *
 * 尺寸用 px 而非 rpx：rpx 随屏宽缩放，横屏（pageOrientation: landscape）
 * 时逻辑宽度翻倍以上，会导致字体/图标整体拉伸 4~5 倍；px 固定不随屏宽变化，
 * 卡片以 max-width + 水平居中适配宽内容栏
 */

.iflow {
  --if-primary: #e2c07c;
  --if-accent: #c98b5a;
  --if-bg: #1c1a17;
  --if-text: #f3e6c8;
  --if-muted: #9a8f7d;
  /* 次级表面：卡片实底 / 柔和叠加底 / 未完成线条（主题可覆盖，见 buildThemeStyle） */
  --if-surface: #26231e;
  --if-soft: rgba(255, 255, 255, 0.04);
  --if-line: #555;

  /* 宽内容栏（横屏）下限制卡片宽度并居中；竖屏 100% 不受影响 */
  max-width: 520px;
  margin-left: auto;
  margin-right: auto;
}

/* ===== 占位小卡（teaser） ===== */
.if-teaser {
  display: flex;
  align-items: center;
  padding: 12px 13px;
  margin-top: 16px;
  margin-bottom: 16px;
  background: var(--if-bg);
  border: 1px solid var(--if-primary);
  border-radius: 14px;
}

.if-teaser-hover {
  opacity: 0.85;
}

.if-teaser-badge {
  flex-shrink: 0;
  padding: 2px 7px;
  margin-right: 11px;
  font-size: 11px;
  font-weight: 600;
  color: var(--if-bg);
  background: var(--if-primary);
  border-radius: 6px;
}

.if-teaser-body {
  flex: 1;
  min-width: 0;
}

.if-teaser-title {
  font-size: 14px;
  font-weight: 500;
  color: var(--if-text);
}

.if-teaser-sub {
  margin-top: 2px;
  font-size: 11px;
  color: var(--if-muted);
}

.if-teaser-go {
  flex-shrink: 0;
  margin-left: 8px;
  font-size: 13px;
  color: var(--if-primary);
}

/* ===== 完整流程 ===== */
.iflow-full {
  position: relative;
  overflow: hidden;
  background: var(--if-bg);
  border: 1px solid rgba(226, 192, 124, 0.3);
  border-radius: 16px;
}

/* 正文内嵌（inline 布局）时与上下文本/组件的间距；popup 弹层内不加 */
.iflow-inline {
  margin-top: 16px;
  margin-bottom: 16px;
}

.if-head {
  padding: 18px 16px 4px;
  text-align: center;
}

.if-title {
  font-size: 16px;
  font-weight: bold;
  color: var(--if-text);
}

.if-sub {
  margin-top: 5px;
  font-size: 12px;
  line-height: 1.5;
  color: var(--if-muted);
}

.if-close {
  position: absolute;
  top: 12px;
  right: 14px;
  z-index: 10;
  padding: 4px;
  font-size: 18px;
  color: var(--if-primary);
  opacity: 0.7;
}

/* 步骤条 */
.if-stepper {
  display: flex;
  align-items: flex-start;
  padding: 14px 28px 0;
  margin-bottom: 14px;
}

.if-snode {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.if-sdot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  transition: background-color 0.3s ease, border-color 0.3s ease;
}

.if-sdot.cur {
  background: var(--if-primary);
}

.if-sdot.done {
  background: transparent;
  border: 2px solid var(--if-primary);
}

.if-sdot.todo {
  background: var(--if-line, #555);
}

.if-sline {
  flex: 1;
  height: 2px;
  margin-top: 6px;
  background: var(--if-line, #333);
  transition: background-color 0.3s ease;
}

.if-sline.on {
  background: var(--if-primary);
}

.if-slabel {
  margin-top: 7px;
  font-size: 13px;
  color: #555;
}

.if-slabel.on {
  color: var(--if-primary);
}

/* 步骤内容 */
.if-step {
  padding: 0 16px 14px;
}

/* 切步方向动画：前进从右侧滑入、后退从左侧滑入（wx:if 重建节点时播放） */
.if-anim-fwd {
  animation: ifStepFwd 0.32s ease-out both;
}

.if-anim-back {
  animation: ifStepBack 0.32s ease-out both;
}

@keyframes ifStepFwd {
  from {
    opacity: 0;
    transform: translateX(24px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes ifStepBack {
  from {
    opacity: 0;
    transform: translateX(-24px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.if-step-title {
  margin-bottom: 12px;
  font-size: 15px;
  font-weight: bold;
  text-align: center;
  color: var(--if-text);
}

/* 场景卡 */
.if-scene {
  display: flex;
  align-items: center;
  min-height: 70px;
  padding: 10px 14px;
  margin-bottom: 10px;
  background: var(--if-surface, #26231e);
  border-radius: 12px;
}

.if-scene-hover {
  opacity: 0.85;
}

.if-scene-info {
  flex: 1;
  min-width: 0;
}

.if-scene-tag {
  margin-bottom: 3px;
  font-size: 12px;
  letter-spacing: 1px;
  color: var(--if-primary);
}

.if-scene-name {
  font-size: 16px;
  color: var(--if-text);
}

.if-scene-desc {
  margin-top: 3px;
  font-size: 13px;
  line-height: 1.5;
  color: var(--if-muted);
}

.if-scene-arrow {
  flex-shrink: 0;
  margin-left: 10px;
  font-size: 16px;
  color: var(--if-muted);
}

/* 策略选项 */
.if-caption {
  margin-bottom: 10px;
  font-size: 15px;
  color: var(--if-primary);
}

.if-situation {
  padding: 12px 14px;
  margin-bottom: 12px;
  font-size: 13px;
  line-height: 1.8;
  color: var(--if-text);
  background: var(--if-soft, rgba(255, 255, 255, 0.04));
  border-radius: 12px;
  opacity: 0.9;
}

.if-opt {
  padding: 12px 14px;
  margin-bottom: 10px;
  background: var(--if-surface, #211e1a);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
}

.if-opt-hover {
  opacity: 0.85;
}

.if-opt-head {
  display: flex;
  align-items: center;
  margin-bottom: 6px;
}

.if-opt-dot {
  flex-shrink: 0;
  width: 14px;
  height: 14px;
  margin-right: 10px;
  border: 1px solid var(--if-primary);
  border-radius: 50%;
  background: transparent;
}

.if-opt-dot.sel {
  background: var(--if-primary);
}

.if-opt-badge {
  flex-shrink: 0;
  padding: 2px 9px;
  margin-right: 12px;
  font-size: 13px;
  line-height: 1.4;
  border-radius: 7px;
}

/* 选项徽章轮换三色（按序号取模） */
.if-opt-badge.b0 {
  color: var(--if-primary);
  background: rgba(226, 192, 124, 0.15);
  border: 1px solid var(--if-primary);
}

.if-opt-badge.b1 {
  color: var(--if-muted);
  background: var(--if-soft, rgba(255, 255, 255, 0.04));
  border: 1px solid var(--if-line, #555);
}

.if-opt-badge.b2 {
  color: var(--if-accent);
  background: rgba(201, 139, 90, 0.15);
  border: 1px solid var(--if-accent);
}

.if-opt-text {
  font-size: 14px;
  line-height: 1.7;
  color: var(--if-text);
}

/* 结果 */
.if-result-title {
  margin-bottom: 8px;
  font-size: 15px;
  font-weight: bold;
  color: var(--if-primary);
}

.if-result-body {
  font-size: 14px;
  line-height: 1.8;
  color: var(--if-text);
  opacity: 0.92;
}

/* 富文本字段（加粗/颜色等局部样式） */
.if-situation rich-text,
.if-opt-text rich-text,
.if-result-body rich-text,
.if-block-title rich-text,
.if-block-body rich-text {
  display: block;
  width: 100%;
}

/* 附加解读块（通用：标题/内容/色调由数据决定） */
.if-block {
  padding: 12px 14px;
  margin-top: 12px;
  background: rgba(127, 127, 127, 0.08);
  border: 1px solid rgba(127, 127, 127, 0.28);
  border-radius: 12px;
}

.if-block-title {
  margin-bottom: 5px;
  font-size: 13px;
  font-weight: bold;
  color: var(--if-text);
  opacity: 0.85;
}

.if-block-body {
  font-size: 13px;
  line-height: 1.7;
  color: var(--if-muted);
}

/* 强调色调（如 概念卡） */
.if-block.emphasis {
  background: rgba(226, 192, 124, 0.06);
  border-color: rgba(226, 192, 124, 0.35);
}

.if-block.emphasis .if-block-title {
  color: var(--if-primary);
  opacity: 1;
}

.if-block.emphasis .if-block-body {
  color: var(--if-text);
  opacity: 0.85;
}

/* 警示色调（如 代价卡） */
.if-block.warning {
  background: rgba(201, 139, 90, 0.08);
  border-color: rgba(201, 139, 90, 0.4);
}

.if-block.warning .if-block-title {
  color: var(--if-accent);
  opacity: 1;
}

.if-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20px;
}

.if-action-btn {
  padding: 10px 22px;
  font-size: 13px;
  line-height: 1;
  border-radius: 999px;
}

.if-action-btn.left {
  color: var(--if-text);
  background: var(--if-soft, rgba(255, 255, 255, 0.04));
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.if-action-btn.right {
  color: var(--if-primary);
  background: rgba(226, 192, 124, 0.08);
  border: 1px solid rgba(226, 192, 124, 0.4);
}

.if-btn-hover {
  opacity: 0.8;
}

/* 底部操作条 */
.if-actionbar {
  min-height: 36px;
  padding: 8px 16px 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.if-prev {
  display: inline-block;
  font-size: 14px;
  color: #999;
}
